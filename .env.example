# Copy this file to `.env.local` for local dev and set the value.
# On Netlify / Amplify, add the same variable in the site's environment
# settings and redeploy.

# Google Apps Script Web App URL for the reviews endpoint.
# After deploying scripts/app-scripts as a Web App in your Apps Script project,
# paste the /exec URL here. Leave empty to disable reviews features gracefully
# (reviews page shows "being set up" message, hero trust line is hidden,
# submission form shows the coming-soon state).
VITE_REVIEWS_ENDPOINT=
