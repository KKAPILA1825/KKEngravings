// ============================================================================
// File 8 / 10  --  Orders.gs (ACTIVE)
// ============================================================================

function handleOrderSubmission_(payload) {
  const idempotencyKey = String((payload && payload.idempotencyKey) || '');
  const validation = validateOrder_(payload || {});
  if (validation.errors && validation.errors.length > 0) {
    return jsonResponse_({ ok: false, reason: 'invalid', details: validation.errors });
  }
  const p = validation.sanitized;

  // 1) Idempotency: same submission key seen in last 10 min → return cached result.
  const idem = checkIdempotency_('ord', idempotencyKey);
  if (idem.seen) {
    return jsonResponse_({ ok: true, id: idem.id, emailStatus: idem.emailStatus, idempotent: true });
  }
  // 2) Content dedup: same content in last 60s → return existing ID (safety net
  //    for double-clicks from an older bundle that didn't send a key).
  const contentHash = orderContentHash_(p);
  const cdh = checkContentDedup_('ord', contentHash);
  if (cdh.seen) {
    return jsonResponse_({ ok: true, id: cdh.id, emailStatus: cdh.emailStatus, idempotent: true });
  }

  const lock = LockService.getDocumentLock();
  lock.waitLock(LIMITS.lockTimeoutMs);
  let id;
  try {
    const sheet = getSheet_(SHEET_NAMES.orders);
    ensureColumns_(sheet, ORDER_COLUMNS, ORDER_COLUMN_ALIASES);
    const colMap = readHeaderMap_(sheet, ORDER_COLUMN_ALIASES);
    id = generateIdWithinLock_(sheet, colMap, ORDER_ID_PREFIX);
    const row = buildOrderRow_(id, p, colMap);
    sheet.appendRow(row);
  } finally {
    lock.releaseLock();
  }

  try {
    applySheetFormatting_(
      getSheet_(SHEET_NAMES.orders),
      ORDER_COLUMNS,
      ORDER_WRAPPED_COLUMNS,
      ORDER_COLUMN_ALIASES
    );
  } catch (err) {
    console.warn('[KK] orders formatting skipped:', err && err.message);
  }

  let emailStatus;
  try {
    sendOrderAlertEmail_(id, p);
    emailStatus = 'sent';
  } catch (err) {
    emailStatus = 'failed: ' + ((err && err.message) || 'unknown');
    console.error('[KK] order email send failed for', id, err);
  }
  console.log('[KK] order', id, 'email:', emailStatus);

  // Record idempotency + content hash so retries/double-clicks get the same id.
  recordIdempotency_('ord', idempotencyKey, id, emailStatus);
  recordContentDedup_('ord', contentHash, id, emailStatus);

  return jsonResponse_({ ok: true, id: id, emailStatus: emailStatus });
}

function validateOrder_(p) {
  const errors = [];
  if (!p.fullName || String(p.fullName).trim().length < 1) errors.push('missing-name');
  if (!isEmail_(p.email)) errors.push('invalid-email');
  if (!p.phone || String(p.phone).replace(/\D/g, '').length < 7) errors.push('invalid-phone');
  if (!p.line1 || String(p.line1).trim().length < 3) errors.push('missing-address');
  if (!p.city || String(p.city).trim().length < 1) errors.push('missing-city');
  if (!p.state || String(p.state).trim().length < 1) errors.push('missing-state');
  if (!p.postalCode || String(p.postalCode).trim().length < 3) errors.push('missing-zip');
  if (!Array.isArray(p.items) || p.items.length === 0) errors.push('empty-cart');
  if (errors.length > 0) return { errors: errors, sanitized: null };
  return {
    errors: [],
    sanitized: {
      fullName: sanitize_(p.fullName, 120),
      email: sanitize_(p.email, LIMITS.emailMax).toLowerCase(),
      phone: sanitize_(p.phone, 30),
      line1: sanitize_(p.line1, 160),
      line2: sanitize_(p.line2, 160),
      city: sanitize_(p.city, 80),
      state: sanitize_(p.state, 30),
      postalCode: sanitize_(p.postalCode, 20),
      country: sanitize_(p.country, 30) || 'US',
      items: (p.items || []).map(function (it) {
        return {
          designTitle: sanitize_(it.designTitle, 200),
          variantLabel: sanitize_(it.variantLabel, 200),
          engravingText: sanitize_(it.engravingText, 2000),
          occasionNote: sanitize_(it.occasionNote, 200),
          quantity: Math.max(1, Math.min(99, parseInt(it.quantity, 10) || 1)),
        };
      }),
    },
  };
}

function composeCustomerLine_(fullName, email, phone) {
  return [fullName, email, phone].filter(Boolean).join(' · ');
}

function composeShippingAddress_(p) {
  const lines = [p.line1];
  if (p.line2) lines.push(p.line2);
  lines.push(p.city + ', ' + p.state + ' ' + p.postalCode);
  lines.push(p.country || 'US');
  return lines.join('\n');
}

function composeOrderSummary_(items) {
  return items.map(function (it, i) {
    const header = (i + 1) + '. ' + it.quantity + '× ' + (it.designTitle || '(design)') +
      (it.variantLabel ? ' — ' + it.variantLabel : '');
    const engraving = it.engravingText ? '\n   Engrave: ' + it.engravingText : '';
    const occasion = it.occasionNote ? '\n   Occasion: ' + it.occasionNote : '';
    return header + engraving + occasion;
  }).join('\n\n');
}

function buildOrderRow_(id, p, colMap) {
  let width = 0;
  for (const k in colMap) if (colMap[k] + 1 > width) width = colMap[k] + 1;
  const row = new Array(width).fill('');
  const put = function (name, value) {
    const i = colMap[name];
    if (i !== undefined) row[i] = value;
  };
  put('Timestamp', new Date());
  put('ID', id);
  put('Customer', composeCustomerLine_(p.fullName, p.email, p.phone));
  put('Shipping to', composeShippingAddress_(p));
  put('Order', composeOrderSummary_(p.items));
  put('Status', 'NEW');
  return row;
}

function sendOrderAlertEmail_(id, p) {
  const sheetUrl = SpreadsheetApp.getActiveSpreadsheet().getUrl();
  const totalItems = p.items.reduce(function (n, it) { return n + it.quantity; }, 0);
  const subject = '[KK Engravings] New order ' + id + ' — ' + totalItems + ' item' + (totalItems === 1 ? '' : 's');

  const itemsHtml = p.items.map(function (it) {
    return '<li style="margin-bottom:10px;">' +
      '<strong>' + it.quantity + '× ' + esc_(it.designTitle || '(design)') + '</strong>' +
      (it.variantLabel ? ' — ' + esc_(it.variantLabel) : '') +
      (it.engravingText ? '<br><em>Engrave:</em> ' + esc_(it.engravingText).replace(/\n/g, '<br>') : '') +
      (it.occasionNote ? '<br><em>Occasion:</em> ' + esc_(it.occasionNote) : '') +
    '</li>';
  }).join('');

  const htmlBody =
    '<div style="font-family: Georgia, serif; max-width: 640px; line-height: 1.6; color: #2b2a28;">' +
    '<h2 style="color:#5a3a1c; margin: 0 0 16px;">New order — ' + esc_(id) + '</h2>' +
    '<table style="border-collapse: collapse; margin-bottom: 16px;">' +
    emailRow_('Customer', esc_(p.fullName)) +
    emailRow_('Email', esc_(p.email)) +
    emailRow_('Phone', esc_(p.phone)) +
    emailRow_('Shipping to', esc_(composeShippingAddress_(p)).replace(/\n/g, '<br>')) +
    '</table>' +
    '<h3 style="color:#5a3a1c; margin: 20px 0 6px;">Items (' + totalItems + ')</h3>' +
    '<ul style="padding-left: 20px;">' + itemsHtml + '</ul>' +
    '<hr style="border: none; border-top: 1px solid #e3d7bf; margin: 24px 0;">' +
    '<p style="font-size: 14px; color: #666;">' +
    '<a href="' + sheetUrl + '">Open spreadsheet</a> — reply to confirm pricing, shipping, and payment.' +
    '</p>' +
    '</div>';

  MailApp.sendEmail({
    to: RECIPIENT_EMAIL,
    subject: subject,
    htmlBody: htmlBody,
    name: 'KK Engravings Website',
    replyTo: p.email,
  });
}


