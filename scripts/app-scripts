// File 9 / 10  --  Custom.gs (ACTIVE)
// ============================================================================

function handleCustomSubmission_(payload) {
  const idempotencyKey = String((payload && payload.idempotencyKey) || '');
  const validation = validateCustom_(payload || {});
  if (validation.errors && validation.errors.length > 0) {
    return jsonResponse_({ ok: false, reason: 'invalid', details: validation.errors });
  }
  const p = validation.sanitized;

  const idem = checkIdempotency_('cus', idempotencyKey);
  if (idem.seen) {
    return jsonResponse_({ ok: true, id: idem.id, emailStatus: idem.emailStatus, idempotent: true });
  }
  const contentHash = customContentHash_(p);
  const cdh = checkContentDedup_('cus', contentHash);
  if (cdh.seen) {
    return jsonResponse_({ ok: true, id: cdh.id, emailStatus: cdh.emailStatus, idempotent: true });
  }

  const lock = LockService.getDocumentLock();
  lock.waitLock(LIMITS.lockTimeoutMs);
  let id;
  try {
    const sheet = getSheet_(SHEET_NAMES.custom);
    ensureColumns_(sheet, CUSTOM_COLUMNS, CUSTOM_COLUMN_ALIASES);
    const colMap = readHeaderMap_(sheet, CUSTOM_COLUMN_ALIASES);
    id = generateIdWithinLock_(sheet, colMap, CUSTOM_ID_PREFIX);
    const row = buildCustomRow_(id, p, colMap);
    sheet.appendRow(row);
  } finally {
    lock.releaseLock();
  }

  try {
    applySheetFormatting_(
      getSheet_(SHEET_NAMES.custom),
      CUSTOM_COLUMNS,
      CUSTOM_WRAPPED_COLUMNS,
      CUSTOM_COLUMN_ALIASES
    );
  } catch (err) {
    console.warn('[KK] custom formatting skipped:', err && err.message);
  }

  let emailStatus;
  try {
    sendCustomAlertEmail_(id, p);
    emailStatus = 'sent';
  } catch (err) {
    emailStatus = 'failed: ' + ((err && err.message) || 'unknown');
    console.error('[KK] custom email send failed for', id, err);
  }
  console.log('[KK] custom', id, 'email:', emailStatus);

  recordIdempotency_('cus', idempotencyKey, id, emailStatus);
  recordContentDedup_('cus', contentHash, id, emailStatus);

  return jsonResponse_({ ok: true, id: id, emailStatus: emailStatus });
}

function validateCustom_(p) {
  const errors = [];
  if (!p.fullName || String(p.fullName).trim().length < 1) errors.push('missing-name');
  if (!isEmail_(p.email)) errors.push('invalid-email');
  const idea = sanitize_(p.idea, 3000);
  if (idea.length < 10) errors.push('idea-too-short');
  if (errors.length > 0) return { errors: errors, sanitized: null };
  return {
    errors: [],
    sanitized: {
      fullName: sanitize_(p.fullName, 120),
      email: sanitize_(p.email, LIMITS.emailMax).toLowerCase(),
      phone: sanitize_(p.phone, 30),
      occasion: sanitize_(p.occasion, 200),
      idea: idea,
      references: Array.isArray(p.references) ? p.references.map(function (r) {
        return { title: sanitize_(r.title, 200), imageFull: sanitize_(r.imageFull, 500) };
      }).slice(0, 15) : [],
    },
  };
}

function composeCustomRequest_(p) {
  let out = p.idea;
  if (p.references && p.references.length > 0) {
    out += '\n\nGallery references (' + p.references.length + '):';
    p.references.forEach(function (r, i) {
      out += '\n' + (i + 1) + '. ' + r.title;
      if (r.imageFull) out += '\n   ' + r.imageFull;
    });
  }
  return out;
}

function buildCustomRow_(id, p, colMap) {
  let width = 0;
  for (const k in colMap) if (colMap[k] + 1 > width) width = colMap[k] + 1;
  const row = new Array(width).fill('');
  const put = function (name, value) {
    const i = colMap[name];
    if (i !== undefined) row[i] = value;
  };
  put('Timestamp', new Date());
  put('ID', id);
  put('Customer', composeCustomerLine_(p.fullName, p.email, p.phone));
  put('Occasion', p.occasion);
  put('Request', composeCustomRequest_(p));
  put('Status', 'NEW');
  return row;
}

function sendCustomAlertEmail_(id, p) {
  const sheetUrl = SpreadsheetApp.getActiveSpreadsheet().getUrl();
  const subject = '[KK Engravings] Custom request ' + id + ' from ' + p.fullName;

  const refsHtml = (p.references && p.references.length > 0)
    ? '<h3 style="color:#5a3a1c; margin: 20px 0 6px;">Gallery references (' + p.references.length + ')</h3>' +
      '<ul style="padding-left: 20px;">' +
      p.references.map(function (r) {
        return '<li><strong>' + esc_(r.title) + '</strong>' +
          (r.imageFull ? '<br><a href="' + esc_(r.imageFull) + '">' + esc_(r.imageFull) + '</a>' : '') +
          '</li>';
      }).join('') + '</ul>'
    : '';

  const htmlBody =
    '<div style="font-family: Georgia, serif; max-width: 640px; line-height: 1.6; color: #2b2a28;">' +
    '<h2 style="color:#5a3a1c; margin: 0 0 16px;">Custom request — ' + esc_(id) + '</h2>' +
    '<table style="border-collapse: collapse; margin-bottom: 16px;">' +
    emailRow_('Customer', esc_(p.fullName)) +
    emailRow_('Email', esc_(p.email)) +
    (p.phone ? emailRow_('Phone', esc_(p.phone)) : '') +
    (p.occasion ? emailRow_('Occasion', esc_(p.occasion)) : '') +
    '</table>' +
    '<h3 style="color:#5a3a1c; margin: 20px 0 6px;">Idea</h3>' +
    '<blockquote style="border-left: 3px solid #c9a961; padding: 4px 16px; margin: 12px 0; color: #333; background: #f7f1e7;">' +
    esc_(p.idea).replace(/\n/g, '<br>') +
    '</blockquote>' +
    refsHtml +
    '<hr style="border: none; border-top: 1px solid #e3d7bf; margin: 24px 0;">' +
    '<p style="font-size: 14px; color: #666;">' +
    '<a href="' + sheetUrl + '">Open spreadsheet</a> — reply to send a quote.' +
    '</p>' +
    '</div>';

  MailApp.sendEmail({
    to: RECIPIENT_EMAIL,
    subject: subject,
    htmlBody: htmlBody,
    name: 'KK Engravings Website',
    replyTo: p.email,
  });
}

