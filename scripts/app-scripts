  const payload = { rating: 10, firstName: '', body: 'too short' };
  const resp = doPost({ postData: { contents: JSON.stringify({ type: 'review', payload: payload }) } });
  Logger.log(resp.getContent());
}

function test_RateLimitSecondAttempt() {
  // Run test_SubmitSampleReview first, then this. Expected: rate-limited.
  test_SubmitSampleReview();
}

function test_FetchReviews() {
  const resp = doGet({ parameter: { type: 'reviews' } });
  Logger.log(resp.getContent());
}

function test_ClearRateLimits() {
  const props = PropertiesService.getScriptProperties();
  const all = props.getProperties();
  let removed = 0;
  for (const key in all) {
    if (key.indexOf('rl_') === 0) {
      props.deleteProperty(key);
      removed++;
    }
  }
  Logger.log('Cleared ' + removed + ' rate-limit entries.');
}


