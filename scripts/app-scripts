  Logger.log('Formatting applied to Reviews tab.');
}

function test_SubmitSampleReview() {
  const payload = {
    rating: 5,
    firstName: 'Jane',
    lastInitial: 'S.',
    email: 'test+review@example.com',
    city: 'Chicago',
    state: 'IL',
    headline: 'Beautiful work',
    body: 'KK made us a custom bear family puzzle for our 5-year anniversary. Fast turnaround, beautiful finish, personal communication throughout.',
    referencedDesign: 'family-plaque-design-2',
    hp: '',
  };
  const resp = doPost({ postData: { contents: JSON.stringify({ type: 'review', payload: payload }) } });
  Logger.log(resp.getContent());
}

function test_HoneypotTripped() {
  const payload = {
    rating: 5,
    firstName: 'Bot',
    email: 'bot@spam.com',
    body: 'This submission should be silently dropped by the honeypot.',
    hp: 'I am a bot filling every field',
  };
  const resp = doPost({ postData: { contents: JSON.stringify({ type: 'review', payload: payload }) } });
  Logger.log(resp.getContent());
}

